---
import PostPreview from "@/components/blog/PostPreview.astro";
import PinCard from "@/components/hubs/PinCard.astro";
import ProjectList from "@/components/hubs/ProjectList.astro";
import { getProjects } from "@/data/hubs";
import { getAllPosts, getPinnedPost, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const RECENT_POSTS = 6;
const HOME_PROJECTS = 3;

const posts = sortMDByDate(await getAllPosts());
const pinned = getPinnedPost(posts);
const recent = posts.filter((p) => p !== pinned).slice(0, RECENT_POSTS);
const projects = (await getProjects()).slice(0, HOME_PROJECTS);
---

<PageLayout meta={{ title: "Home" }}>
	<h1 class="page-title">Tiago Flora</h1>

	{pinned && <PinCard post={pinned} />}

	<section>
		<h2 class="section-title">Recent writing</h2>
		<ul class="post-list">
			{
				recent.map((p) => (
					<li>
						<PostPreview as="h3" post={p} />
					</li>
				))
			}
		</ul>
		<p class="meta more"><a href="/posts/">All writing</a></p>
	</section>

	<section>
		<h2 class="section-title">Projects</h2>
		<ProjectList projects={projects} variant="compact" />
		<p class="meta more"><a href="/projects/">All projects</a></p>
	</section>
</PageLayout>

<style>
	.more {
		margin-top: 1.2rem;
	}
</style>
