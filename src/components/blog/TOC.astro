---
import type { MarkdownHeading } from "astro";

import { generateToc, type TocItem } from "@/utils";

interface Props {
	headings: MarkdownHeading[];
}

const toc = generateToc(Astro.props.headings, { maxHeadingLevel: 3 });
---

{
	toc.length >= 3 && (
		<details class="toc">
			<summary class="meta">Contents</summary>
			<ol>
				{toc.map((h: TocItem) => (
					<li>
						<a href={`#${h.slug}`}>{h.text}</a>
						{!!h.children.length && (
							<ol>
								{h.children.map((c) => (
									<li>
										<a href={`#${c.slug}`}>{c.text}</a>
									</li>
								))}
							</ol>
						)}
					</li>
				))}
			</ol>
		</details>
	)
}

<style>
	.toc {
		margin: -1rem 0 2.5rem;
		font-size: 0.9rem;
	}

	summary {
		cursor: pointer;
		width: fit-content;
	}

	ol {
		margin: 0.5rem 0 0;
		padding-inline-start: 1.2rem;
	}

	ol ol {
		margin-top: 0.15rem;
	}

	li + li {
		margin-top: 0.15rem;
	}

	a {
		text-decoration-color: transparent;
	}

	a:hover {
		text-decoration-color: currentColor;
	}
</style>
