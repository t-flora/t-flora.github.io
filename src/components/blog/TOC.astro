---
import type { TocItem } from "@/utils";

import TocList from "./TocList.astro";

interface Props {
	toc: TocItem[];
}

const { toc } = Astro.props;
---

<details class="toc">
	<summary class="meta">Contents</summary>
	<TocList toc={toc} />
</details>
<!-- The rail: sticky contents in the margin on wide screens. It takes the right margin, or the
     left one when sidenotes have the right (see "Contents rail" in global.css). -->
<nav aria-label="Contents" class="toc-rail" data-pagefind-ignore data-toc>
	<div class="rail">
		<p class="rail-title">Contents</p>
		<TocList toc={toc} />
	</div>
</nav>

<style>
	.toc {
		margin: -1rem 0 2.5rem;
		font-size: 0.9rem;
	}

	summary {
		cursor: pointer;
		width: fit-content;
	}

	.toc :global(ol) {
		margin: 0.5rem 0 0;
		padding-inline-start: 1.2rem;
	}

	.toc :global(ol ol) {
		margin-top: 0.15rem;
	}

	.toc :global(li + li) {
		margin-top: 0.15rem;
	}

	.toc :global(a),
	.toc-rail :global(a) {
		text-decoration-color: transparent;
	}

	.toc :global(a:hover) {
		text-decoration-color: currentColor;
	}

	.toc-rail {
		display: none;
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(100% + var(--sidenote-gap));
		width: var(--sidenote-width);
	}

	:global(article:has(.prose .sidenote)) .toc-rail {
		left: auto;
		right: calc(100% + var(--sidenote-gap));
		width: var(--toc-start-width);
	}

	.rail {
		position: sticky;
		top: calc(var(--strip-height) + 1.5rem);
		max-height: calc(100vh - var(--strip-height) - 3rem);
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		font-size: 0.8rem;
		line-height: 1.4;
	}

	.rail-title {
		margin: 0 0 0.6rem;
		color: var(--text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.toc-rail :global(ol) {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toc-rail :global(a) {
		display: block;
		padding: 0.2rem 0 0.2rem 0.7rem;
		border-inline-start: 2px solid var(--rule);
		color: var(--text-muted);
		text-wrap: pretty;
	}

	.toc-rail :global(ol ol a) {
		padding-inline-start: 1.5rem;
	}

	.toc-rail :global(a:hover) {
		color: var(--text);
	}

	/* Set by ReadingStrip's script as the reader moves through the post. */
	.toc-rail :global(a[aria-current]) {
		border-inline-start-color: var(--accent);
		color: var(--text);
	}

	@media (min-width: 72rem) {
		:global(article:not(:has(.prose .sidenote))) .toc {
			display: none;
		}

		:global(article:not(:has(.prose .sidenote))) .toc-rail {
			display: block;
		}
	}

	@media (min-width: 82rem) {
		.toc {
			display: none;
		}

		.toc-rail {
			display: block;
		}
	}
</style>
