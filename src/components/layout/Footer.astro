---
import { siteConfig, socialLinks } from "@/site-config";

const year = new Date().getFullYear();
// Stored reversed and assembled in the browser so the address isn't in the HTML as-is.
const reversedEmail = [...siteConfig.email].reverse().join("");
---

<footer class="site-footer meta">
	<span>&copy; {year} {siteConfig.author}</span>
	<ul>
		<li><a data-email={reversedEmail} href="/" id="email-link">Email</a></li>
		{
			socialLinks.map(({ link, name }) => (
				<li>
					<a href={link} rel="noopener noreferrer">
						{name}
					</a>
				</li>
			))
		}
		<li><a href="/rss.xml">RSS</a></li>
	</ul>
</footer>

<script>
	const link = document.getElementById("email-link") as HTMLAnchorElement | null;
	if (link?.dataset.email) link.href = `mailto:${[...link.dataset.email].reverse().join("")}`;
</script>

<style>
	.site-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		/* Border spans the text column only, not the page padding. */
		width: calc(100% - 2 * var(--page-padding));
		max-width: calc(var(--measure) + var(--frame-extra));
		margin: 0 auto;
		padding: 2rem var(--frame-extra) 2.5rem 0;
		border-top: 1px solid var(--rule);
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
