---
import { menuLinks } from "@/site-config";

import Search from "../Search.astro";
import ThemeToggle from "../ThemeToggle.astro";

const path = Astro.url.pathname;
const isCurrent = (linkPath: string) =>
	path.startsWith(linkPath);
---

<header class="site-header">
	<a aria-current={path === "/" ? "page" : undefined} class="wordmark" href="/">tflora</a>
	<nav aria-label="Main">
		{
			menuLinks.map((link) => (
				<a aria-current={isCurrent(link.path) ? "page" : undefined} data-astro-prefetch href={link.path}>
					{link.title}
				</a>
			))
		}
	</nav>
	<div class="tools">
		<Search />
		<ThemeToggle />
	</div>
</header>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 1.6rem;
		width: 100%;
		max-width: calc(var(--measure) + var(--frame-extra) + 2 * var(--page-padding));
		margin: 0 auto;
		padding: 2rem calc(var(--frame-extra) + var(--page-padding)) 3rem var(--page-padding);
	}

	.wordmark {
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-decoration: none;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.1rem;
		font-size: 0.95rem;
	}

	nav a {
		color: var(--text-muted);
		text-decoration-color: transparent;
	}

	nav a:hover,
	nav a[aria-current="page"] {
		color: var(--text);
		text-decoration-color: var(--link-underline);
	}

	.tools {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin-inline-start: auto;
		align-self: center;
	}
</style>
