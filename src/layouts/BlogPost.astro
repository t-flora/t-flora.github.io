---
import { type CollectionEntry, render } from "astro:content";

import LinkPreviews from "@/components/LinkPreviews.astro";
import PostHeader from "@/components/blog/PostHeader.astro";
import ReadingStrip from "@/components/blog/ReadingStrip.astro";
import TOC from "@/components/blog/TOC.astro";
import { getReadingMinutes } from "@/data/post";
import { generateToc } from "@/utils";

import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const {
	data: { description, lastReviewed, ogImage, publishDate, title },
	id,
} = post;
const socialImage = ogImage ?? `/og-image/${id}.png`;
const articleDate = (lastReviewed ?? publishDate).toISOString();
const { headings } = await render(post);
// The footnotes' "Notes" heading isn't a section, and wide screens hide it behind sidenotes.
const toc = generateToc(
	headings.filter((h) => h.slug !== "footnote-label"),
	{ maxHeadingLevel: 3 },
);
// Short posts don't need a table of contents.
const showToc = toc.length >= 3;
---

<BaseLayout meta={{ articleDate, description, ogImage: socialImage, title }}>
	<ReadingStrip minutes={getReadingMinutes(post)} title={title} toc={showToc ? toc : []} />
	<article data-pagefind-body>
		<PostHeader post={post} />
		{showToc && <TOC toc={toc} />}
		<div class="prose" data-link-previews>
			<slot />
		</div>
		{
			post.data.substack && (
				<p class="meta discuss">
					<a href={post.data.substack}>Discuss this post on Substack</a>
				</p>
			)
		}
	</article>
	<LinkPreviews />
</BaseLayout>

<style>
	/* The contents rail (TOC.astro) hangs off the article's edges. */
	article {
		position: relative;
	}

	.discuss {
		margin-top: 3rem;
	}
</style>
